# --- Kinetic backend environment template ----------------------------------
#
# Copy this file to `.env` (same directory) and fill in real values for
# local development, OR override these vars in your deployment environment.
# `.env` is gitignored; `.env.example` is committed.
#
# The backend auto-loads `.env` at import time via python-dotenv (see
# `app/api.py`). Variables already exported in the shell take precedence
# over the file, so this is safe to use in CI/CD too.

# --- Auth -------------------------------------------------------------------

# When `true`, every call to /decision, /availability/week, /travel
# REQUIRES a valid Firebase ID token in `Authorization: Bearer <token>`.
# Anything else (including unset) → permissive: tokens are decoded if
# present but missing/invalid tokens are allowed through. Use permissive
# only for solo local dev; flip to true everywhere else.
KINETIC_AUTH_REQUIRED=false

# Path to the Firebase Admin service-account JSON. The auth dependency
# accepts either FIREBASE_CREDENTIALS or GOOGLE_APPLICATION_CREDENTIALS;
# both are checked in that order. In docker-compose the file is mounted
# at /run/secrets/firebase-admin.json — that path is the default below.
# For non-docker local dev, point this at the absolute path on disk.
FIREBASE_CREDENTIALS=/run/secrets/firebase-admin.json

# Local signed-device QA can verify Firebase ID tokens without privileged
# Admin credentials by setting the exact Firebase project ID. Signature,
# audience, issuer, expiry, and subject are still validated against Google's
# published Firebase certificates. A real credential file takes precedence.
# FIREBASE_PROJECT_ID=kinetic-aca73

# --- CORS -------------------------------------------------------------------

# Comma-separated list of allowed origins. Defaults to local dev only.
# In production set this to your real domain(s), e.g.:
#   KINETIC_CORS_ORIGINS=https://kinetic.app,https://staging.kinetic.app
KINETIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI runtime -------------------------------------------------------------

# fallback     = default deterministic explanation mode, no model/network call
# local_ollama = optional no-cost live AI demo mode against local Ollama
# disabled     = deterministic/debug mode with AI explicitly off
KINETIC_AI_MODE=fallback

# Only used when KINETIC_AI_MODE=local_ollama.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=20
# Keep synchronous intake on a smaller instruction model; other AI surfaces
# continue using OLLAMA_MODEL.
INTAKE_OLLAMA_MODEL=llama3.2:3b
# Intake must return or fall back before the frontend's 30-second deadline.
INTAKE_LLM_TIMEOUT_SECONDS=24
# Model-quality evals currently select qwen3:8b for grounded summaries.
SUMMARY_OLLAMA_MODEL=qwen3:8b
SUMMARY_LLM_TIMEOUT_SECONDS=24

# --- Optional: Google Calendar ---------------------------------------------

# If you want the calendar integration to work, drop the OAuth client JSON
# at this path. Same `secrets/` directory convention as the SA file.
# GOOGLE_CALENDAR_CREDENTIALS=/run/secrets/credentials.json
