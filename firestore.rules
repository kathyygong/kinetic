rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isKineticDomain(domain) {
      return domain in [
        'profile',
        'goal',
        'plan',
        'plan_history',
        'plan_operations',
        'readiness',
        'workouts',
        'recommendations',
        'preferences',
        'settings',
        'onboarding',
        'dismissed_preferences',
        'today',
        'schedule',
        'calendar_sync',
        'calendar_failure',
        'health_sync',
        'mobile_audit'
      ];
    }

    match /users/{userId}/kinetic/{domain} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && isKineticDomain(domain);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
